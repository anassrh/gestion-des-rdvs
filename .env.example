VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key
# Only these public values belong in VITE_* variables. No service-role key needed.

# Server-side notification integration. Set these on the deployment server too.
N8N_APPOINTMENT_WEBHOOK_URL=https://your-instance.app.n8n.cloud/webhook/your-webhook-path
N8N_ADMIN_NOTIFICATION_EMAIL=your-notification-email@example.com
APP_PUBLIC_URL=http://localhost:8082
